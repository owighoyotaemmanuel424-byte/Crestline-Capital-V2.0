generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum UserRole { USER ADMIN }
enum WithdrawalStatus { PENDING APPROVED REJECTED }
model User { id String @id @default(uuid()) email String @unique fullName String? role UserRole @default(USER) createdAt DateTime @default(now()) accounts Account[] withdrawalRequests WithdrawalRequest[] }
model Account { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id]) type String @default("PRIMARY") currency String @default("USD") entries Entry[] createdAt DateTime @default(now()) }
model Transaction { id String @id @default(uuid()) description String reference String? @unique metadata Json? entries Entry[] createdAt DateTime @default(now()) }
model Entry { id String @id @default(uuid()) accountId String account Account @relation(fields:[accountId],references:[id]) transactionId String transaction Transaction @relation(fields:[transactionId],references:[id]) amount Decimal @db.Decimal(20,8) createdAt DateTime @default(now()) }
model WithdrawalRequest { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id]) amount Decimal @db.Decimal(20,8) status WithdrawalStatus @default(PENDING) notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }