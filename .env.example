# Convex production
NEXT_PUBLIC_CONVEX_URL="https://YOUR-DEPLOYMENT.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://YOUR-DEPLOYMENT.convex.site"
CONVEX_DEPLOY_KEY="set-in-Vercel/CI only"
SITE_URL="https://YOUR-CRESTLINE-DOMAIN"
BETTER_AUTH_SECRET="generate-a-long-random-secret-at-least-32-characters"
PAYSTACK_SECRET_KEY="set-in-Convex production environment only"
MIGRATION_SECRET="set-in-Convex production environment only"

# Legacy services retained only during data migration/cutover.
# Remove these after migration verification and legacy backend decommissioning.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/crestline"
JWT_SECRET="legacy-only"
DATABASE_URL="legacy-only"
NEXT_PUBLIC_SUPABASE_URL="legacy-only"
NEXT_PUBLIC_SUPABASE_ANON_KEY="legacy-only"
SUPABASE_SERVICE_ROLE_KEY="legacy-only"
