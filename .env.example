# Optional: leave unset on Vercel to use the same-domain /api serverless API.
NEXT_PUBLIC_API_URL=

# Required for the Express/MongoDB banking API.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/crestline"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Existing application integrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
